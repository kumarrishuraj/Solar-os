# ==============================================================================
# SolarOS Backend Environment Variables (Template)
# Copy this file to .env and replace placeholders with your actual values.
# DO NOT commit .env files containing real secrets to version control.
# ==============================================================================

# Application Settings
PROJECT_NAME="SolarOS"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Origins (Comma-separated list or JSON array)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Supabase / PostgreSQL Connection
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# For local development with SQLite fallback: sqlite:///./solaros.db
DATABASE_URL="postgresql://postgres:your_supabase_db_password@db.your_project.supabase.co:5432/postgres"

# Supabase API Credentials
SUPABASE_URL="https://your_project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# AI / LLM Configuration
OPENAI_API_KEY="your_openai_api_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"
LLM_MODEL="gemini-1.5-flash"

# YOLO / Computer Vision Model Settings
YOLO_WEIGHTS_PATH="app/ai/weights/yolov8_rooftop.pt"
CONFIDENCE_THRESHOLD=0.45

# Authentication & Security Secrets
SECRET_KEY="replace_this_with_a_secure_random_string_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
